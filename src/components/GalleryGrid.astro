---
import type { GalleryImage } from '../data/images';

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="gallery-grid">
  {images.map((image) => (
    <a id={`img-${image.id}`} href={`${base}/image/${image.id}/`} class="gallery-link">
      <figure class="gallery-item">
        <img src={`${base}${image.src}`} alt={image.alt} loading="lazy" />
        <figcaption>{image.title}</figcaption>
      </figure>
    </a>
  ))}
</div>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .gallery-link {
    text-decoration: none;
    color: inherit;
  }

  .gallery-item {
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    border: 1px solid #ddd;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }

  .gallery-item img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  figcaption {
    padding: 0.75rem 1rem;
    font-size: 0.95rem;
    color: #444;
  }

  @media (prefers-color-scheme: dark) {
    .gallery-item {
      background: #161616;
      border-color: #222;
    }

    .gallery-item:hover {
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    }

    figcaption {
      color: #ccc;
    }
  }
</style>
