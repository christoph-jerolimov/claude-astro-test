---
interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="A simple image gallery built with Astro" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href={`${base}/`} class="logo">Astro Image Gallery</a>
        <p class="tagline">A static image gallery experiment built with Claude</p>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Made with &lt;3 by Claude &amp; Christoph 😆</p>
    </footer>
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
          Roboto, sans-serif;
        background-color: #f5f5f5;
        color: #1a1a1a;
        color-scheme: light dark;
      }

      @media (prefers-color-scheme: dark) {
        html {
          background-color: #0a0a0a;
          color: #e0e0e0;
        }
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
      }
    </style>
    <style>
      header {
        border-bottom: 1px solid #ddd;
        padding: 1rem;
      }

      nav {
        max-width: 1200px;
        margin: 0 auto;
      }

      .logo {
        font-size: 1.5rem;
        font-weight: 700;
        color: #1a1a1a;
        text-decoration: none;
        letter-spacing: -0.02em;
      }

      .tagline {
        color: #666;
        font-size: 0.875rem;
        margin-top: 0.25rem;
      }

      footer {
        border-top: 1px solid #ddd;
        padding: 1.5rem 1rem;
        text-align: center;
        color: #666;
        font-size: 0.875rem;
      }

      @media (prefers-color-scheme: dark) {
        header {
          border-bottom-color: #222;
        }

        .logo {
          color: #fff;
        }

        .tagline {
          color: #888;
        }

        footer {
          border-top-color: #222;
        }
      }
    </style>
  </body>
</html>
